  "plan_phases": [
    {
      "phase": "P1 Graph Integrity Baseline",
      "scope": "Parser stability + section-boundary + table schema + duplicate IDs",
      "deliverables": "Lint suite in scripts/ (IDs, markdown-table rows, end markers, duplicate anchors), CI gate as non-blocking then blocking",
      "why": "Prevents new graph corruption and keeps PR stack mergeable by non-specialists"
    },
    {
      "phase": "P2 Canonical ID Governance",
      "scope": "Normalize ID grammar and status enum vocabulary",
      "deliverables": "Canonical regex + alias registry + status enum checker + autofix hints",
      "why": "Machine joins and cross-part references become deterministic"
    },
    {
      "phase": "P3 Missing Nodes Strategy",
      "scope": "Resolve unresolved references (63 currently): roadmap vs normative",
      "deliverables": "For normative refs add stub ## sections or remap to real owner IDs; for roadmap refs tag Planned and exclude from conformance graph",
      "why": "Conformance computation becomes complete and auditable"
    },
    {
      "phase": "P4 Core Cycle Reduction",
      "scope": "Refactor largest SCCs (sizes 17 and 13)",
      "deliverables": "Dependency inversion notes, extracted interfaces, explicit owner boundaries between A/E/F/G",
      "why": "Reduces cascading breakage and simplifies independent evolution"
    },
    {
      "phase": "P5 Continuous Dependency Observability",
      "scope": "Publish dependency snapshots and drift reports on each release",
      "deliverables": "`review/dependency-graph-<date>.md` + HTML artifact + trend deltas",
      "why": "Early detection of unresolved IDs and sudden cross-part coupling spikes"
    }
  ],
